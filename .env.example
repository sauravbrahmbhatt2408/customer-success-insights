# Postgres (used by docker compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=csinsights

# Backend. These hosts are for running the API outside Docker;
# compose overrides DATABASE_URL and REDIS_URL to use the service names.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/csinsights
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when served over HTTPS
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Leave the key empty to use a fake insight response locally
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# First admin, created by seed.py
ADMIN_EMAIL=admin@csinsights.io
ADMIN_PASSWORD=Welcome123
